// Parameters. Paths are relative to the launch directory unless absolute.
params {
    outdir          = 'results'
    cache_dir       = 'cache'              // downloaded inputs (storeDir; reused across runs)
    python          = "${projectDir}/../.venv/bin/python"

    samples_hg19    = "${projectDir}/../data/samples_hg19_wavelet.csv"
    samples_rnaseq  = "${projectDir}/../data/samples_rnaseq.csv"
    samples_drug    = "${projectDir}/../data/samples_drug_fractions.csv"
    samples_uw_fractions = "${projectDir}/../data/samples_uw_fractions.csv"
    qc              = true                 // UW track rebuild + comparison with ENCODE
    cell_lines      = 'all'                // comma-separated hg19 labels, or 'all'

    // Reference files (public; md5-checked)
    gencode_url = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_44/GRCh37_mapping/gencode.v44lift37.basic.annotation.gtf.gz'
    gencode_md5 = '74b40c9bdb697cb085b005555eeef1a7'
    // Drug-treatment Repli-seq: Koundrioukoff et al. 2026, Zenodo archive (CC BY 4.0)
    drug_archive_url = 'https://zenodo.org/records/19093559/files/Koundrioukoff_et_al_NAR_2026.zip'
    drug_archive_md5 = 'c50336d2b1f887bdd80456208713b92c'


    max_downloads   = 4
    before_script   = ''                   // shell run before each task, e.g. 'module load ...'
}

process {
    withLabel: small  { cpus = 1; memory = '8 GB';  time = '2h' }
    withLabel: medium { cpus = 1; memory = '24 GB'; time = '4h' }
}

profiles {
    local {
        process.executor = 'local'
        executor.cpus    = 8
    }
    slurm {
        // Generic Slurm. Set the partition with --slurm_queue; add site options with --slurm_options.
        params.slurm_queue   = null
        params.slurm_options = ''
        process.executor       = 'slurm'
        process.queue          = { params.slurm_queue }
        process.clusterOptions = { params.slurm_options }
        process.beforeScript   = { params.before_script }
        process.errorStrategy  = 'retry'          // one retry for node-level failures
        process.maxRetries     = 1
        executor.queueSize     = 50
        // Downloads are I/O bound: run them on the head node, not as Slurm jobs.
        process {
            withName: 'FETCH.*' { executor = 'local' }
        }
        executor {
            $local { cpus = 4 }
        }
    }
}

manifest {
    name            = 'hlb-rt-paper'
    description     = 'Replication timing of replication-dependent histone genes'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10'
}
